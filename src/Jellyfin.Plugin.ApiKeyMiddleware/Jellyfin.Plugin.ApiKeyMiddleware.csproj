<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Jellyfin.Plugin.ApiKeyMiddleware</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyVersion>12.4.0.1</AssemblyVersion>
    <FileVersion>12.4.0.1</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- Jellyfin version the plugin is built and tested against. The plugin version follows it:
         <jellyfin major.minor.patch>.<plugin revision>. -->
    <PackageReference Include="Jellyfin.Controller" Version="12.4.0" />
    <PackageReference Include="Jellyfin.Model" Version="12.4.0" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Configuration\configPage.html" />
    <EmbeddedResource Include="Configuration\configPage.html" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Jellyfin.Plugin.ApiKeyMiddleware.Tests" />
  </ItemGroup>

</Project>
